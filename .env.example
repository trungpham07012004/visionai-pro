# Sao chep thanh .env va tu dien API key Gemini tren may cua ban.
GEMINI_API_KEY=
# Model chinh va du phong theo thu tu. Quyen truy cap/quota tuy tai khoan va model.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
STT_LANGUAGE=vi-VN
TESSERACT_CMD=
